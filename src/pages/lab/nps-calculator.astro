---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/tool.css';
---

<BaseLayout
	title="NPS Confidence Calculator — Levent Can"
	description="NPS is a difference of two proportions, not a single number — see how much a small sample size can swing it, and how many responses you actually need."
>
	<section class="section prose-wide">
		<a class="back" href="/lab">← Lab</a>
		<span class="tag">TOOL</span>
		<h1>NPS Confidence Calculator</h1>
		<p class="intro">
			NPS is a difference of two proportions (% promoters − % detractors), and with a small
			sample it can swing a lot more than it looks like it should. This shows the real margin of
			error for your NPS, and how many responses you'd actually need to trust it. Nothing here is
			sent anywhere; it runs entirely in your browser.
		</p>

		<div class="settings-row">
			<label
				>Confidence level
				<select class="tool-input" id="confidence-select">
					<option value="90">90%</option>
					<option value="95" selected>95%</option>
					<option value="99">99%</option>
				</select>
			</label>
		</div>

		<div class="nps-panel">
			<h3>Your current NPS</h3>
			<div class="counts-row">
				<label
					>Promoters <span class="hint">(9–10)</span>
					<input class="tool-input" type="number" id="promoters-input" min="0" /></label
				>
				<label
					>Passives <span class="hint">(7–8)</span>
					<input class="tool-input" type="number" id="passives-input" min="0" /></label
				>
				<label
					>Detractors <span class="hint">(0–6)</span>
					<input class="tool-input" type="number" id="detractors-input" min="0" /></label
				>
			</div>

			<div class="results-panel">
				<div class="score-display">
					<div class="score-number" id="nps-number">—</div>
					<div class="score-status" id="nps-status"></div>
				</div>
				<div class="alert-banner" id="reliability-banner" hidden></div>

				<div class="range-bar">
					<div class="range-track">
						<div class="range-zero"></div>
						<div class="range-band" id="range-band"></div>
						<div class="range-marker" id="range-marker"></div>
					</div>
					<div class="range-labels"><span>-100</span><span>0</span><span>+100</span></div>
				</div>

				<ul class="breakdown-list" id="nps-breakdown"></ul>
			</div>
		</div>

		<div class="nps-panel">
			<h3>How many responses do you need?</h3>
			<p class="panel-note">
				Assumes the promoter/detractor split above —
				<button type="button" class="link-btn" id="sync-btn">match current split</button> or override
				to plan ahead.
			</p>
			<div class="counts-row">
				<label
					>Assumed promoters
					<input class="tool-input" type="number" id="assumed-promoter-input" min="0" max="100" />%</label
				>
				<label
					>Assumed detractors
					<input class="tool-input" type="number" id="assumed-detractor-input" min="0" max="100" />%</label
				>
				<label
					>Target margin of error ±<input
						class="tool-input"
						type="number"
						id="target-moe-input"
						min="0.1"
						step="0.5"
					/> points</label
				>
			</div>

			<div class="results-panel">
				<div class="score-display">
					<div class="score-number" id="required-n">—</div>
					<div class="score-status">responses needed</div>
				</div>
			</div>
		</div>

		<div class="share-row">
			<button type="button" class="btn-ghost" id="copy-link-btn">Copy shareable link</button>
			<button type="button" class="btn-ghost" id="copy-summary-btn">Copy summary as text</button>
			<span class="copy-feedback" id="copy-feedback"></span>
		</div>
	</section>
</BaseLayout>

<script>
	import { computeNps, marginOfError, requiredSampleSize, reliability } from '../../lib/nps-stats.js';

	const STORAGE_KEY = 'nps-calculator-v1';

	function defaultState() {
		return {
			promoters: 40,
			passives: 35,
			detractors: 25,
			confidence: 95,
			assumedPromoterPct: 40,
			assumedDetractorPct: 25,
			planningTouched: false,
			targetMoE: 5,
		};
	}

	function loadState() {
		try {
			const params = new URLSearchParams(location.search);
			const shared = params.get('s');
			if (shared) {
				const parsed = JSON.parse(decodeURIComponent(shared));
				if (parsed && typeof parsed.promoters === 'number') return { ...defaultState(), ...parsed };
			}
		} catch (e) {
			// ignore malformed share links
		}
		try {
			const saved = localStorage.getItem(STORAGE_KEY);
			if (saved) {
				const parsed = JSON.parse(saved);
				if (parsed && typeof parsed.promoters === 'number') return { ...defaultState(), ...parsed };
			}
		} catch (e) {
			// localStorage unavailable
		}
		return defaultState();
	}

	let state = loadState();
	let saveTimer;
	function scheduleSave() {
		clearTimeout(saveTimer);
		saveTimer = setTimeout(() => {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
			} catch (e) {
				// non-fatal
			}
		}, 300);
	}

	const promotersInput = document.getElementById('promoters-input');
	const passivesInput = document.getElementById('passives-input');
	const detractorsInput = document.getElementById('detractors-input');
	const confidenceSelect = document.getElementById('confidence-select');
	const assumedPromoterInput = document.getElementById('assumed-promoter-input');
	const assumedDetractorInput = document.getElementById('assumed-detractor-input');
	const targetMoeInput = document.getElementById('target-moe-input');

	function clamp(v, min, max) {
		return Math.min(Math.max(v, min), max);
	}
	function valueToPercent(v) {
		return ((clamp(v, -100, 100) + 100) / 200) * 100;
	}

	function syncAssumedFromActual() {
		const total = state.promoters + state.passives + state.detractors;
		if (total <= 0) return;
		state.assumedPromoterPct = Math.round((state.promoters / total) * 100);
		state.assumedDetractorPct = Math.round((state.detractors / total) * 100);
		assumedPromoterInput.value = String(state.assumedPromoterPct);
		assumedDetractorInput.value = String(state.assumedDetractorPct);
	}

	function renderResults() {
		const nps = computeNps(state.promoters, state.passives, state.detractors);
		const moe = marginOfError(state.promoters, state.passives, state.detractors, state.confidence);

		const npsNumberEl = document.getElementById('nps-number');
		const npsStatusEl = document.getElementById('nps-status');
		const bannerEl = document.getElementById('reliability-banner');
		const breakdownEl = document.getElementById('nps-breakdown');
		const bandEl = document.getElementById('range-band');
		const markerEl = document.getElementById('range-marker');

		if (nps === null) {
			npsNumberEl.textContent = '—';
			npsNumberEl.className = 'score-number';
			npsStatusEl.textContent = 'Enter response counts';
			bannerEl.hidden = true;
			bandEl.style.width = '0';
			markerEl.style.left = '50%';
		} else {
			npsNumberEl.textContent = nps >= 0 ? `+${nps.toFixed(1)}` : nps.toFixed(1);
			npsNumberEl.className = 'score-number pass';
			npsStatusEl.textContent = `± ${moe.toFixed(1)} points at ${state.confidence}% confidence`;

			const rel = reliability(moe);
			bannerEl.hidden = false;
			bannerEl.className = `alert-banner tone-${rel.tone}`;
			bannerEl.textContent = `${rel.label} — the true NPS is likely between ${(nps - moe).toFixed(1)} and ${(nps + moe).toFixed(1)}.`;

			const low = valueToPercent(nps - moe);
			const high = valueToPercent(nps + moe);
			bandEl.style.left = `${low}%`;
			bandEl.style.width = `${Math.max(high - low, 0.5)}%`;
			markerEl.style.left = `${valueToPercent(nps)}%`;
		}

		const total = state.promoters + state.passives + state.detractors;
		breakdownEl.innerHTML = '';
		const rows = [
			['Total responses', total, ''],
			['Promoters', state.promoters, total ? `${Math.round((state.promoters / total) * 100)}%` : ''],
			['Passives', state.passives, total ? `${Math.round((state.passives / total) * 100)}%` : ''],
			['Detractors', state.detractors, total ? `${Math.round((state.detractors / total) * 100)}%` : ''],
		];
		for (const [label, count, pct] of rows) {
			const li = document.createElement('li');
			li.innerHTML = `<span class="bd-name">${label}</span><span class="bd-weight">${count}</span><span class="bd-score">${pct}</span>`;
			breakdownEl.appendChild(li);
		}

		const requiredNEl = document.getElementById('required-n');
		const n = requiredSampleSize(
			(state.assumedPromoterPct || 0) / 100,
			(state.assumedDetractorPct || 0) / 100,
			state.targetMoE,
			state.confidence
		);
		requiredNEl.textContent = n === null ? '—' : n.toLocaleString();
	}

	promotersInput.addEventListener('input', () => {
		state.promoters = Number(promotersInput.value) || 0;
		if (!state.planningTouched) syncAssumedFromActual();
		renderResults();
		scheduleSave();
	});
	passivesInput.addEventListener('input', () => {
		state.passives = Number(passivesInput.value) || 0;
		if (!state.planningTouched) syncAssumedFromActual();
		renderResults();
		scheduleSave();
	});
	detractorsInput.addEventListener('input', () => {
		state.detractors = Number(detractorsInput.value) || 0;
		if (!state.planningTouched) syncAssumedFromActual();
		renderResults();
		scheduleSave();
	});
	confidenceSelect.addEventListener('change', () => {
		state.confidence = Number(confidenceSelect.value);
		renderResults();
		scheduleSave();
	});
	assumedPromoterInput.addEventListener('input', () => {
		state.planningTouched = true;
		state.assumedPromoterPct = Number(assumedPromoterInput.value) || 0;
		renderResults();
		scheduleSave();
	});
	assumedDetractorInput.addEventListener('input', () => {
		state.planningTouched = true;
		state.assumedDetractorPct = Number(assumedDetractorInput.value) || 0;
		renderResults();
		scheduleSave();
	});
	targetMoeInput.addEventListener('input', () => {
		state.targetMoE = Number(targetMoeInput.value) || 0;
		renderResults();
		scheduleSave();
	});
	document.getElementById('sync-btn').addEventListener('click', () => {
		state.planningTouched = false;
		syncAssumedFromActual();
		renderResults();
		scheduleSave();
	});

	function flashCopyFeedback(message) {
		const el = document.getElementById('copy-feedback');
		el.textContent = message;
		setTimeout(() => {
			if (el.textContent === message) el.textContent = '';
		}, 2000);
	}

	document.getElementById('copy-link-btn').addEventListener('click', async () => {
		const url = `${location.origin}${location.pathname}?s=${encodeURIComponent(JSON.stringify(state))}`;
		try {
			await navigator.clipboard.writeText(url);
			flashCopyFeedback('Link copied.');
		} catch (e) {
			flashCopyFeedback('Could not copy — copy manually from the address bar after sharing.');
		}
	});

	document.getElementById('copy-summary-btn').addEventListener('click', async () => {
		const nps = computeNps(state.promoters, state.passives, state.detractors);
		const moe = marginOfError(state.promoters, state.passives, state.detractors, state.confidence);
		const n = requiredSampleSize(
			(state.assumedPromoterPct || 0) / 100,
			(state.assumedDetractorPct || 0) / 100,
			state.targetMoE,
			state.confidence
		);
		const lines = [
			`NPS: ${nps === null ? '—' : nps.toFixed(1)} ± ${moe === null ? '—' : moe.toFixed(1)} (${state.confidence}% confidence)`,
			`Sample: ${state.promoters} promoters, ${state.passives} passives, ${state.detractors} detractors`,
			`Responses needed for ±${state.targetMoE} points: ${n === null ? '—' : n}`,
		];
		try {
			await navigator.clipboard.writeText(lines.join('\n'));
			flashCopyFeedback('Summary copied.');
		} catch (e) {
			flashCopyFeedback('Could not copy to clipboard.');
		}
	});

	// initial render
	promotersInput.value = String(state.promoters);
	passivesInput.value = String(state.passives);
	detractorsInput.value = String(state.detractors);
	confidenceSelect.value = String(state.confidence);
	assumedPromoterInput.value = String(state.assumedPromoterPct);
	assumedDetractorInput.value = String(state.assumedDetractorPct);
	targetMoeInput.value = String(state.targetMoE);
	renderResults();
</script>

<style is:global>
	.nps-panel {
		margin-top: 40px;
	}
	.hint {
		color: var(--text-dim);
		font-size: 0.75rem;
	}
	.counts-row {
		display: flex;
		gap: 24px;
		flex-wrap: wrap;
		margin: 16px 0 20px;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.counts-row label {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.counts-row input {
		width: 90px;
	}
	.panel-note {
		font-size: 0.85rem;
		color: var(--text-dim);
		margin: 4px 0 4px;
	}
	.link-btn {
		background: none;
		border: none;
		color: var(--cyan);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		cursor: pointer;
		padding: 0;
		text-decoration: underline;
	}

	.range-bar {
		margin: 18px 0;
	}
	.range-track {
		position: relative;
		height: 10px;
		background: var(--bg-panel-raised);
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.range-zero {
		position: absolute;
		left: 50%;
		top: -3px;
		bottom: -3px;
		width: 1px;
		background: var(--border-bright);
	}
	.range-band {
		position: absolute;
		top: 0;
		bottom: 0;
		background: rgba(45, 226, 255, 0.25);
		border-radius: 6px;
	}
	.range-marker {
		position: absolute;
		top: -4px;
		bottom: -4px;
		width: 3px;
		background: var(--cyan);
		border-radius: 2px;
		box-shadow: 0 0 8px rgba(45, 226, 255, 0.6);
	}
	.range-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.7rem;
		color: var(--text-dim);
		margin-top: 6px;
	}
</style>
