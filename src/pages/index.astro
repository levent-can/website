---
import BaseLayout from '../layouts/BaseLayout.astro';
import { caseStudies } from '../data/work.js';
import { tools } from '../data/lab.js';

const latestCaseStudy = caseStudies[caseStudies.length - 1];
const latestTool = tools[tools.length - 1];
---

<BaseLayout
	title="Levent Can — Business Analysis, Data, Automation"
	description="Levent Can turns business problems into data-driven tools: dashboards, automations, and small working applications."
	personSchema
>
	<section class="hero">
		<div class="container">
			<span class="tag">STATUS: ACTIVE BUILD</span>
			<h1 class="wordmark">LEVENT&nbsp;CAN</h1>
			<p class="role">Business Analysis / Data / Automation / Experiments</p>
			<p class="intro">
				I turn business problems into data-driven tools — dashboards, automations, and small
				applications that people actually use. This site is both a portfolio and a working lab.
			</p>
		</div>
	</section>

	<section class="section container">
		<h3>What I'm building now</h3>
		<p><a href="/now">See the current list on /now →</a></p>
	</section>

	<section class="section container">
		<h3>Selected work</h3>
		<div class="featured">
			<a href={latestCaseStudy.slug}>{latestCaseStudy.title}</a>
			<p>{latestCaseStudy.summary}</p>
		</div>
		<p class="see-all">
			<a href="/work">See all {caseStudies.length} case studies on /work →</a>
		</p>
	</section>

	<section class="section container">
		<h3>Lab</h3>
		<div class="featured">
			<a href={latestTool.slug}>{latestTool.title}</a>
			<p>{latestTool.summary}</p>
		</div>
		<p class="see-all"><a href="/lab">See all {tools.length} tools on /lab →</a></p>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 96px 0 64px;
		border-bottom: 1px solid var(--border);
		background:
			radial-gradient(ellipse 60% 50% at 50% 0%, rgba(155, 92, 255, 0.18), transparent 70%);
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 5vw, 3rem);
		line-height: 1.5;
		margin: 20px 0 12px;
		text-shadow: 0 0 20px rgba(45, 226, 255, 0.35), 0 0 40px rgba(255, 46, 196, 0.2);
	}
	.role {
		font-family: var(--font-mono);
		color: var(--cyan);
		letter-spacing: 0.04em;
		margin: 0 0 24px;
	}
	.intro {
		max-width: 60ch;
		color: var(--text-muted);
	}

	.featured {
		border-left: 2px solid var(--violet);
		padding-left: 16px;
		margin-top: 16px;
	}
	.featured a {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text);
		border: none;
	}
	.featured a:hover {
		color: var(--cyan);
	}
	.featured p {
		margin: 6px 0 0;
		color: var(--text-muted);
		max-width: 65ch;
	}
	.see-all {
		margin-top: 16px;
		font-size: 0.9rem;
	}
</style>
