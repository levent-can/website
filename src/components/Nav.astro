---
const links = [
	{ href: '/work', label: 'WORK' },
	{ href: '/lab', label: 'LAB' },
	{ href: '/now', label: 'NOW' },
	{ href: '/about', label: 'ABOUT' },
];
const path = Astro.url.pathname;
---

<header class="nav">
	<div class="container nav-inner">
		<a class="wordmark" href="/">LEVENT_CAN</a>
		<nav>
			<ul>
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								class:list={{ active: path.startsWith(link.href) }}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.nav {
		border-bottom: 1px solid var(--border);
		background: rgba(10, 4, 23, 0.85);
		backdrop-filter: blur(6px);
		position: sticky;
		top: 0;
		z-index: 20;
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
		gap: 12px;
	}
	.wordmark {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.04em;
		color: var(--text);
		border: none;
	}
	.wordmark:hover {
		color: var(--cyan);
	}
	nav ul {
		display: flex;
		gap: 28px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		border: none;
		padding-bottom: 4px;
	}
	nav a:hover {
		color: var(--cyan);
	}
	nav a.active {
		color: var(--cyan);
		border-bottom: 2px solid var(--cyan);
	}

	@media (max-width: 480px) {
		.wordmark {
			font-size: 0.8rem;
		}
		nav ul {
			gap: 14px;
		}
		nav a {
			font-size: 0.7rem;
		}
	}
</style>
